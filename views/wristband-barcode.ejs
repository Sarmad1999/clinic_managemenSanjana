<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Barcode Wristband — UHC Clinic</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<%- include('partials/nav', { user }) %>
<div class="container" style="max-width:750px">

  <h4 class="mb-3">
    <i class="bi bi-person-badge me-2 text-dark"></i>Barcode Wristband
    — <%= patient.full_name %>
  </h4>

  <% if (success) { %>
  <div class="alert alert-success alert-dismissible fade show">
    <i class="bi bi-check-circle-fill me-2"></i><%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
  <% } %>
  <% if (error) { %>
  <div class="alert alert-danger alert-dismissible fade show">
    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
  <% } %>

  <!-- Patient summary -->
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-secondary text-white">
      <h6 class="mb-0"><i class="bi bi-person-circle me-2"></i>Patient Information</h6>
    </div>
    <div class="card-body">
      <table class="table table-borderless table-sm mb-0">
        <tr><th class="text-muted" style="width:140px">Patient ID:</th>
            <td><strong>#<%= patient.patient_id %></strong></td></tr>
        <tr><th class="text-muted">Full Name:</th>  <td><strong><%= patient.full_name %></strong></td></tr>
        <tr><th class="text-muted">Age:</th>        <td><%= patient.age %></td></tr>
        <tr><th class="text-muted">Gender:</th>     <td><%= patient.gender %></td></tr>
      </table>
    </div>
  </div>

  <!-- Barcode wristband card -->
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
      <h6 class="mb-0"><i class="bi bi-upc me-2"></i>Barcode Wristband</h6>
      <button class="btn btn-sm btn-outline-light" onclick="window.print()">
        <i class="bi bi-printer me-1"></i>Print
      </button>
    </div>
    <div class="card-body text-center py-4" id="printArea">

      <% if (wristband) { %>
      <div class="border rounded p-3 d-inline-block bg-white shadow-sm" style="min-width:380px">
        <div class="fw-bold fs-5 mb-1"><%= patient.full_name %></div>
        <div class="text-muted small mb-2">
          ID: #<%= patient.patient_id %> &nbsp;|&nbsp;
          Age: <%= patient.age %> &nbsp;|&nbsp;
          <%= patient.gender %>
        </div>
        <!-- JsBarcode renders Code 128 SVG here -->
        <svg id="barcodeImg" class="d-block mx-auto"></svg>
        <div class="font-monospace small mt-2 text-muted"><%= wristband.barcode_data %></div>
        <div class="text-muted" style="font-size:.75rem">
          Issued: <%= new Date(wristband.issued_at).toLocaleString() %>
        </div>
        <div class="mt-2">
          <span class="badge bg-danger">UHC Clinic</span>
          <span class="badge bg-secondary ms-1">Patient Wristband</span>
        </div>
      </div>

      <% } else { %>
      <div class="py-4 text-muted">
        <i class="bi bi-upc fs-1 d-block mb-2"></i>
        No barcode wristband has been issued for this patient yet.
      </div>
      <% } %>
    </div>
  </div>

  <!-- Issue / re-issue wristband -->
  <% if (['admin','receptionist'].includes(user.role)) { %>
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
      <h6 class="mb-0">
        <i class="bi bi-plus-circle me-2"></i><%= wristband ? 'Re-issue' : 'Issue' %> Barcode Wristband
      </h6>
    </div>
    <div class="card-body">
      <% if (wristband) { %>
      <div class="alert alert-warning mb-3">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        A wristband is already active. Re-issuing will generate a new barcode.
      </div>
      <% } %>
      <form method="POST" action="/barcode-wristband"
            onsubmit="return confirm('Issue a barcode wristband for this patient?')">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="patient_id" value="<%= patient.patient_id %>">
        <button type="submit" class="btn btn-primary">
          <i class="bi bi-upc me-2"></i><%= wristband ? 'Re-issue New' : 'Issue' %> Barcode Wristband
        </button>
      </form>
    </div>
  </div>
  <% } %>

  <div class="d-flex gap-2">
    <a href="/scan-barcode"     class="btn btn-outline-secondary">
      <i class="bi bi-upc-scan me-1"></i>Scan Barcode
    </a>
    <a href="/appointments/new" class="btn btn-outline-primary">
      <i class="bi bi-calendar-plus me-1"></i>Book Appointment
    </a>
    <a href="/dashboard"        class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i>Dashboard
    </a>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<% if (wristband) { %>
<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
<script>
  JsBarcode('#barcodeImg', '<%= wristband.barcode_data %>', {
    format:       'CODE128',
    width:        2,
    height:       60,
    displayValue: false,
    margin:       8
  });
</script>
<% } %>

<style>
@media print {
  body > * { display: none !important; }
  #printArea { display: block !important; }
  .btn { display: none !important; }
}
</style>
</body>
</html>
