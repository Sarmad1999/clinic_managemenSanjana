<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Scan Barcode — UHC Clinic</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<%- include('partials/nav', { user }) %>
<div class="container" style="max-width:900px">

  <h4 class="mb-2">
    <i class="bi bi-upc-scan me-2 text-dark"></i>Barcode Scanner
  </h4>
  <p class="text-muted mb-3">
    Scan a patient wristband barcode with a USB or Bluetooth barcode reader,
    or enter the barcode manually. Format: <code>BC-{patient_id}-{timestamp}</code>.
  </p>

  <% if (error) { %>
  <div class="alert alert-danger alert-dismissible fade show">
    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
  <% } %>

  <div class="row g-4">

    <!-- Hardware scanner / keyboard-wedge -->
    <div class="col-md-6">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-dark text-white">
          <h6 class="mb-0"><i class="bi bi-upc me-2"></i>Hardware Barcode Reader</h6>
        </div>
        <div class="card-body">
          <p class="text-muted small">
            Point a USB or Bluetooth barcode scanner at the wristband.
            Most scanners act as keyboard devices and append <kbd>Enter</kbd>
            automatically — the field auto-submits on scan.
          </p>
          <form action="/scan-barcode" method="POST" id="autoSubmitForm">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-3">
              <label class="form-label fw-semibold">Scanned Barcode</label>
              <input type="text" name="barcode_data" id="barcodeAutoInput"
                     class="form-control font-monospace"
                     placeholder="Waiting for scanner…"
                     autocomplete="off" value="">
              <div class="form-text">Field captures scanner output automatically.</div>
            </div>
            <button type="submit" class="btn btn-dark w-100">
              <i class="bi bi-search me-1"></i>Look Up Patient
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Manual entry -->
    <div class="col-md-6">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-primary text-white">
          <h6 class="mb-0"><i class="bi bi-keyboard me-2"></i>Manual Entry</h6>
        </div>
        <div class="card-body">
          <p class="text-muted small">
            Type the barcode value printed on the wristband.
          </p>
          <form action="/scan-barcode" method="POST" id="manualForm">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-3">
              <label class="form-label fw-semibold">Barcode Value</label>
              <input type="text" name="barcode_data" id="barcodeManualInput"
                     class="form-control font-monospace"
                     placeholder="e.g. BC-3-1710000000000"
                     autocomplete="off">
            </div>
            <button type="submit" class="btn btn-primary w-100">
              <i class="bi bi-search me-1"></i>Look Up Patient
            </button>
          </form>
        </div>
      </div>
    </div>

  </div><!-- /.row -->

  <!-- Patient details after successful scan -->
  <% if (patientData) { %>
  <div class="card shadow-sm mt-4">
    <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
      <h6 class="mb-0">
        <i class="bi bi-person-check me-2"></i>Patient Identified
      </h6>
      <a href="/barcode-wristband/<%= patientData.patient.patient_id %>"
         class="btn btn-sm btn-outline-light">
        <i class="bi bi-person-badge me-1"></i>View Wristband
      </a>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-5">
          <table class="table table-borderless table-sm mb-0">
            <tr><th class="text-muted">Patient ID:</th><td><strong><%= patientData.patient.patient_id %></strong></td></tr>
            <tr><th class="text-muted">Name:</th>      <td><strong><%= patientData.patient.full_name %></strong></td></tr>
            <tr><th class="text-muted">Age:</th>       <td><%= patientData.patient.age %></td></tr>
            <tr><th class="text-muted">Gender:</th>    <td><%= patientData.patient.gender %></td></tr>
          </table>
        </div>
        <div class="col-md-7">
          <div class="d-flex gap-2 mb-2">
            <a href="/appointments/new?patient_id=<%= patientData.patient.patient_id %>"
               class="btn btn-sm btn-outline-primary">
              <i class="bi bi-calendar-plus me-1"></i>Book Appointment
            </a>
          </div>
        </div>
      </div>

      <% if (patientData.appointments && patientData.appointments.length > 0) { %>
      <h6 class="mt-3 mb-2">
        <i class="bi bi-calendar2-week me-2 text-primary"></i>Recent / Upcoming Appointments
      </h6>
      <div class="table-responsive">
        <table class="table table-sm table-hover mb-0">
          <thead class="table-light">
            <tr><th>Date</th><th>Time</th><th>Type</th><th>Provider</th><th>Status</th></tr>
          </thead>
          <tbody>
            <% const sb = { scheduled:'primary', confirmed:'success', cancelled:'secondary', completed:'info', no_show:'warning' }; %>
            <% patientData.appointments.forEach(a => { %>
            <tr>
              <td><%= new Date(a.appointment_date).toLocaleDateString() %></td>
              <td><%= String(a.appointment_time).slice(0,5) %></td>
              <td>
                <% const tc = { doctor:'primary', laboratory:'success', radiology:'secondary' }; %>
                <span class="badge bg-<%= tc[a.appointment_type] || 'dark' %>">
                  <%= a.appointment_type %>
                </span>
              </td>
              <td><%= a.provider_name || '—' %></td>
              <td>
                <span class="badge bg-<%= sb[a.status] || 'secondary' %>">
                  <%= a.status.replace('_', ' ') %>
                </span>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <p class="text-muted small mt-3 mb-0">
        <i class="bi bi-info-circle me-1"></i>No appointments on record.
      </p>
      <% } %>
    </div>
  </div>
  <% } %>

  <a href="/dashboard" class="btn btn-outline-secondary mt-4">
    <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
  </a>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  (function () {
    const input = document.getElementById('barcodeAutoInput');
    const form  = document.getElementById('autoSubmitForm');
    if (!input || !form) return;
    input.focus();
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        if (input.value.trim().length > 0) form.submit();
      }
    });
  })();
</script>
</body>
</html>
