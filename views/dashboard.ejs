<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard — UHC Clinic</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<%- include('partials/nav', { user }) %>
<div class="container">

  <% if (success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="bi bi-check-circle-fill me-2"></i><%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <div class="row mb-4">
    <div class="col">
      <h3>Welcome, <strong><%= user.username %></strong>
        <span class="badge bg-primary ms-2"><%= user.role %></span>
        <% if (user.mfa_enabled) { %>
          <span class="badge bg-success ms-1"><i class="bi bi-shield-check"></i> MFA On</span>
        <% } %>
      </h3>
      <p class="text-muted">
        United Health Care — Appointment &amp; Scheduling System
      </p>
    </div>
  </div>

  <!-- Quick-access cards -->
  <div class="row g-4 mb-5">
    <% if (['admin','doctor','receptionist'].includes(user.role)) { %>

    <div class="col-md-4">
      <a href="/patients/new" class="text-decoration-none">
        <div class="card h-100 border-0 shadow-sm text-center p-4">
          <i class="bi bi-person-plus text-primary fs-1 mb-2"></i>
          <h6 class="fw-bold">Add Patient</h6>
          <p class="text-muted small mb-0">Register a new patient in the system</p>
        </div>
      </a>
    </div>

    <div class="col-md-4">
      <a href="/appointments" class="text-decoration-none">
        <div class="card h-100 border-0 shadow-sm text-center p-4">
          <i class="bi bi-calendar2-week text-primary fs-1 mb-2"></i>
          <h6 class="fw-bold">Appointments</h6>
          <p class="text-muted small mb-0">View, filter and manage all patient appointments</p>
        </div>
      </a>
    </div>

    <div class="col-md-4">
      <a href="/appointments/new" class="text-decoration-none">
        <div class="card h-100 border-0 shadow-sm text-center p-4">
          <i class="bi bi-calendar2-plus text-success fs-1 mb-2"></i>
          <h6 class="fw-bold">New Appointment</h6>
          <p class="text-muted small mb-0">Schedule a doctor, laboratory or radiology visit</p>
        </div>
      </a>
    </div>

    <div class="col-md-4">
      <a href="/scan-barcode" class="text-decoration-none">
        <div class="card h-100 border-0 shadow-sm text-center p-4">
          <i class="bi bi-upc-scan text-dark fs-1 mb-2"></i>
          <h6 class="fw-bold">Scan Barcode</h6>
          <p class="text-muted small mb-0">Identify patients via wristband barcode scanner</p>
        </div>
      </a>
    </div>

    <% } %>

    <% if (!user.mfa_enabled) { %>
    <div class="col-md-4">
      <a href="/mfa-setup" class="text-decoration-none">
        <div class="card h-100 border-0 shadow-sm text-center p-4"
             style="border:2px solid #ffc107 !important">
          <i class="bi bi-shield-exclamation text-warning fs-1 mb-2"></i>
          <h6 class="fw-bold text-warning">Enable MFA</h6>
          <p class="text-muted small mb-0">
            Strengthen your account with two-factor authentication
          </p>
        </div>
      </a>
    </div>
    <% } %>

    <% if (user.role === 'admin') { %>
    <div class="col-md-4">
      <a href="/audit-logs" class="text-decoration-none">
        <div class="card h-100 border-0 shadow-sm text-center p-4">
          <i class="bi bi-journal-text text-danger fs-1 mb-2"></i>
          <h6 class="fw-bold">Audit Logs</h6>
          <p class="text-muted small mb-0">Full activity trail for HIPAA compliance</p>
        </div>
      </a>
    </div>
    <% } %>
  </div>

  <!-- Security status panel -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-bold">
      <i class="bi bi-shield-fill-check text-primary me-2"></i>Security Status
    </div>
    <div class="card-body">
      <ul class="list-group list-group-flush">
        <li class="list-group-item d-flex justify-content-between align-items-center">
          Password hashing (bcrypt, 10 rounds)
          <span class="badge bg-success">Active</span>
        </li>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          Session authentication
          <span class="badge bg-success">Active</span>
        </li>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          Two-Factor Authentication (TOTP)
          <% if (user.mfa_enabled) { %>
            <span class="badge bg-success">Enabled</span>
          <% } else { %>
            <span class="badge bg-warning text-dark">
              Not Enabled — <a href="/mfa-setup">Set up now</a>
            </span>
          <% } %>
        </li>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          CSRF protection (double-submit cookie)
          <span class="badge bg-success">Active</span>
        </li>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          Audit logging (HIPAA)
          <span class="badge bg-success">Active</span>
        </li>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          Role-Based Access Control (RBAC)
          <span class="badge bg-success">Active — Role: <%= user.role %></span>
        </li>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          Security headers (Helmet.js)
          <span class="badge bg-success">Active</span>
        </li>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          Rate limiting (brute-force protection)
          <span class="badge bg-success">Active</span>
        </li>
      </ul>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
