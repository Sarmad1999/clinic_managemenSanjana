<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>MFA Setup — UHC Clinic</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<%- include('partials/nav', { user }) %>
<div class="container" style="max-width:620px">
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-success text-white">
      <h5 class="mb-0"><i class="bi bi-shield-check me-2"></i>Enable Two-Factor Authentication</h5>
    </div>
    <div class="card-body">
      <% if (error) { %>
        <div class="alert alert-danger">
          <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
        </div>
      <% } %>

      <ol class="mb-4">
        <li class="mb-2">Install an authenticator app (e.g. <strong>Google Authenticator</strong> or <strong>Authy</strong>).</li>
        <li class="mb-2">Scan the QR code below with the app.</li>
        <li>Enter the 6-digit code and click <strong>Enable MFA</strong>.</li>
      </ol>

      <div class="text-center mb-3">
        <img src="<%= qrImage %>" alt="MFA QR Code"
             class="img-fluid border rounded p-2" style="max-width:220px">
        <p class="text-muted small mt-2">
          Can't scan? Enter this secret manually:<br>
          <code class="user-select-all"><%= secret %></code>
        </p>
      </div>

      <form method="POST" action="/mfa-setup">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="mb-3">
          <label class="form-label fw-semibold">Enter 6-digit code to confirm</label>
          <input type="text" name="token" class="form-control form-control-lg text-center"
                 placeholder="000000" maxlength="6" minlength="6"
                 pattern="[0-9]{6}" inputmode="numeric" required autofocus
                 style="letter-spacing:0.5rem;font-size:1.8rem">
        </div>
        <button type="submit" class="btn btn-success w-100 py-2">
          <i class="bi bi-shield-check me-2"></i>Enable MFA
        </button>
      </form>
    </div>
  </div>
  <a href="/dashboard" class="text-muted small">← Back to Dashboard</a>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
