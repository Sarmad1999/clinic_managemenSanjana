<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Appointments — UHC Clinic</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    .appt-dot { display:inline-block; width:12px; height:12px; border-radius:50%; margin-right:6px; vertical-align:middle; }
    .legend-item { display:inline-flex; align-items:center; margin-right:14px; font-size:.85rem; }
    .btn-xs { padding:.15rem .4rem; font-size:.75rem; line-height:1.4; }
  </style>
</head>
<body class="bg-light">
<%- include('partials/nav', { user }) %>
<div class="container-fluid">

  <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <h4 class="mb-0">
      <i class="bi bi-calendar2-week me-2 text-primary"></i>Appointments
      <span class="badge bg-secondary ms-2"><%= appointments.length %></span>
    </h4>
    <a href="/appointments/new" class="btn btn-primary btn-sm">
      <i class="bi bi-plus-circle me-1"></i>New Appointment
    </a>
  </div>

  <% if (success) { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="bi bi-check-circle-fill me-2"></i><%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
  <% } %>

  <% if (errors && errors.length > 0) { %>
  <div class="alert alert-danger"><%= errors[0].msg %></div>
  <% } %>

  <!-- Colour legend -->
  <div class="mb-3">
    <span class="legend-item">
      <span class="appt-dot" style="background:#0d6efd"></span>Doctor
    </span>
    <span class="legend-item">
      <span class="appt-dot" style="background:#198754"></span>Laboratory
    </span>
    <span class="legend-item">
      <span class="appt-dot" style="background:#6f42c1"></span>Radiology
    </span>
  </div>

  <!-- Filters -->
  <form method="GET" action="/appointments" class="card shadow-sm p-3 mb-4">
    <div class="row g-2 align-items-end">
      <div class="col-md-3">
        <label class="form-label small mb-1">Date</label>
        <input type="date" name="date" class="form-control form-control-sm"
               value="<%= filters.date %>">
      </div>
      <div class="col-md-3">
        <label class="form-label small mb-1">Type</label>
        <select name="type" class="form-select form-select-sm">
          <option value="">All Types</option>
          <% APPOINTMENT_TYPES.forEach(t => { %>
          <option value="<%= t %>" <%= filters.type === t ? 'selected' : '' %>>
            <%= t.charAt(0).toUpperCase() + t.slice(1) %>
          </option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label small mb-1">Status</label>
        <select name="status" class="form-select form-select-sm">
          <option value="">All Statuses</option>
          <% APPOINTMENT_STATUSES.forEach(s => { %>
          <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>>
            <%= s.charAt(0).toUpperCase() + s.slice(1).replace('_', ' ') %>
          </option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-sm btn-primary flex-grow-1">
          <i class="bi bi-filter me-1"></i>Filter
        </button>
        <a href="/appointments" class="btn btn-sm btn-outline-secondary">
          <i class="bi bi-x-circle"></i>
        </a>
      </div>
    </div>
  </form>

  <!-- Appointments table -->
  <div class="card shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover table-striped mb-0">
          <thead class="table-dark">
            <tr>
              <th>#</th><th>Patient</th><th>Type</th>
              <th>Date</th><th>Time</th><th>Duration</th>
              <th>Provider</th><th>Status</th><th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <%
              const typeIcon = {
                doctor:     'person-lines-fill',
                laboratory: 'eyedropper',
                radiology:  'radioactive'
              };
            %>
            <% appointments.forEach(a => { %>
            <tr>
              <td><%= a.appointment_id %></td>
              <td>
                <span class="appt-dot" style="background:<%= a.color_code %>"></span>
                <strong><%= a.patient_name %></strong>
                <small class="text-muted d-block">ID: <%= a.patient_id %></small>
              </td>
              <td>
                <i class="bi bi-<%= typeIcon[a.appointment_type] || 'calendar-event' %> me-1"
                   style="color:<%= a.color_code %>"></i>
                <%= a.appointment_type.charAt(0).toUpperCase() + a.appointment_type.slice(1) %>
              </td>
              <td><%= new Date(a.appointment_date).toLocaleDateString() %></td>
              <td><%= String(a.appointment_time).slice(0, 5) %></td>
              <td><%= a.duration_minutes %> min</td>
              <td>
                <% if (a.provider_name) { %>
                  <%= a.provider_name %>
                <% } else { %>
                  <span class="text-muted">—</span>
                <% } %>
              </td>
              <td>
                <span class="badge bg-<%= STATUS_BADGE[a.status] || 'secondary' %>">
                  <%= a.status.replace('_', ' ') %>
                </span>
              </td>
              <td>
                <div class="d-flex gap-1">
                  <a href="/appointments/<%= a.appointment_id %>/edit"
                     class="btn btn-xs btn-outline-primary" title="Edit">
                    <i class="bi bi-pencil"></i>
                  </a>
                  <% if (!['cancelled','completed'].includes(a.status)) { %>
                  <form method="POST"
                        action="/appointments/<%= a.appointment_id %>/complete"
                        onsubmit="return confirm('Mark as completed?')"
                        class="d-inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-xs btn-outline-success" title="Complete">
                      <i class="bi bi-check-lg"></i>
                    </button>
                  </form>
                  <form method="POST"
                        action="/appointments/<%= a.appointment_id %>/cancel"
                        onsubmit="return confirm('Cancel this appointment?')"
                        class="d-inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-xs btn-outline-danger" title="Cancel">
                      <i class="bi bi-x-lg"></i>
                    </button>
                  </form>
                  <% } %>
                </div>
              </td>
            </tr>
            <% }) %>
            <% if (appointments.length === 0) { %>
            <tr>
              <td colspan="9" class="text-center text-muted py-4">
                <i class="bi bi-calendar-x me-2"></i>No appointments found.
                <a href="/appointments/new" class="ms-2">Schedule one now</a>
              </td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <a href="/dashboard" class="btn btn-outline-secondary mt-3">
    <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
  </a>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
